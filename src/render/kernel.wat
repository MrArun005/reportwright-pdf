;; The rasterizer's hot loops (raster.js fillNonZero), hand-written: a band's edge areas accumulated into cells, and
;; a row's cells swept into coverage spans. The same IEEE operations in the same order as the JS, so the coverage is
;; bit-identical. JS validates every offset and length before calling in, charges the work, and owns the memory.
;; Build: node scripts/build-kernel.mjs (writes kernel.js, the bytes as base64).
(module
  ;; fixed size, never grown: growing detaches its ArrayBuffer, and one detached buffer slows every typed array in V8
  (memory (export "memory") 1024 1024)

  ;; a[i] += v, as a Float32Array does it: the sum in double, stored as float
  (func $add (param $p i32) (param $v f64)
    (f32.store (local.get $p)
      (f32.demote_f64 (f64.add (f64.promote_f32 (f32.load (local.get $p))) (local.get $v)))))

  ;; one band: S (x0 y0 x1 y1 dir per segment, doubles) → A (float cells, rows × stride), RMIN / RMAX per row
  (func (export "band")
    (param $S i32) (param $ns i32) (param $b0 i32) (param $b1 i32) (param $ox f64) (param $bw i32)
    (param $stride i32) (param $A i32) (param $RMIN i32) (param $RMAX i32)
    (local $o i32) (local $end i32) (local $py0 f64) (local $py1 f64) (local $px0 f64) (local $dxdy f64)
    (local $dir f64) (local $y f64) (local $yb f64) (local $t0 f64) (local $t1 f64) (local $dy f64)
    (local $x f64) (local $xn f64) (local $d f64) (local $ls i32) (local $xl f64) (local $xr f64)
    (local $xlf f64) (local $xli i32) (local $xri i32) (local $ry i32) (local $p i32) (local $bwf f64)
    (local $xmf f64) (local $sl f64) (local $x0f f64) (local $a0 f64) (local $x1f f64) (local $am f64)
    (local $a1 f64) (local $a2 f64) (local $xi i32) (local $r i32) (local $rows i32)
    (local.set $rows (i32.sub (local.get $b1) (local.get $b0)))
    (memory.fill (local.get $A) (i32.const 0)
      (i32.shl (i32.mul (local.get $rows) (local.get $stride)) (i32.const 2)))
    (local.set $r (i32.const 0))
    (block $done (loop $init
      (br_if $done (i32.ge_s (local.get $r) (local.get $rows)))
      (i32.store (i32.add (local.get $RMIN) (i32.shl (local.get $r) (i32.const 2)))
        (i32.add (local.get $bw) (i32.const 1)))
      (i32.store (i32.add (local.get $RMAX) (i32.shl (local.get $r) (i32.const 2))) (i32.const -1))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $init)))
    (local.set $bwf (f64.convert_i32_s (local.get $bw)))
    (local.set $o (local.get $S))
    (local.set $end (i32.add (local.get $S) (i32.mul (local.get $ns) (i32.const 40))))
    (block $segs (loop $seg
      (br_if $segs (i32.ge_u (local.get $o) (local.get $end)))
      (block $next
        (local.set $py0 (f64.load offset=8 (local.get $o)))
        (local.set $py1 (f64.load offset=24 (local.get $o)))
        (br_if $next (f64.le (local.get $py1) (f64.convert_i32_s (local.get $b0))))
        (br_if $next (f64.ge (local.get $py0) (f64.convert_i32_s (local.get $b1))))
        (local.set $px0 (f64.load (local.get $o)))
        (local.set $dxdy (f64.div (f64.sub (f64.load offset=16 (local.get $o)) (local.get $px0))
          (f64.sub (local.get $py1) (local.get $py0))))
        (local.set $dir (f64.load offset=32 (local.get $o)))
        (local.set $y (f64.max (f64.convert_i32_s (local.get $b0)) (f64.floor (local.get $py0))))
        (local.set $yb (f64.min (f64.convert_i32_s (local.get $b1)) (f64.ceil (local.get $py1))))
        (block $rowsdone (loop $row
          (br_if $rowsdone (i32.eqz (f64.lt (local.get $y) (local.get $yb))))
          (block $rownext
            (local.set $t0 (select (local.get $y) (local.get $py0) (f64.gt (local.get $y) (local.get $py0))))
            (local.set $t1 (select (f64.add (local.get $y) (f64.const 1)) (local.get $py1)
              (f64.lt (f64.add (local.get $y) (f64.const 1)) (local.get $py1))))
            (local.set $dy (f64.sub (local.get $t1) (local.get $t0)))
            (br_if $rownext (f64.le (local.get $dy) (f64.const 0)))
            (local.set $x (f64.sub (f64.add (local.get $px0)
              (f64.mul (f64.sub (local.get $t0) (local.get $py0)) (local.get $dxdy))) (local.get $ox)))
            (local.set $xn (f64.sub (f64.add (local.get $px0)
              (f64.mul (f64.sub (local.get $t1) (local.get $py0)) (local.get $dxdy))) (local.get $ox)))
            (local.set $x (select (f64.const 0)
              (select (local.get $bwf) (local.get $x) (f64.gt (local.get $x) (local.get $bwf)))
              (f64.lt (local.get $x) (f64.const 0))))
            (local.set $xn (select (f64.const 0)
              (select (local.get $bwf) (local.get $xn) (f64.gt (local.get $xn) (local.get $bwf)))
              (f64.lt (local.get $xn) (f64.const 0))))
            (local.set $d (f64.mul (local.get $dy) (local.get $dir)))
            (local.set $ry (i32.sub (i32.trunc_sat_f64_s (local.get $y)) (local.get $b0)))
            (local.set $ls (i32.mul (local.get $ry) (local.get $stride)))
            (local.set $xl (select (local.get $x) (local.get $xn) (f64.lt (local.get $x) (local.get $xn))))
            (local.set $xr (select (local.get $xn) (local.get $x) (f64.lt (local.get $x) (local.get $xn))))
            (local.set $xlf (f64.floor (local.get $xl)))
            (local.set $xli (i32.trunc_sat_f64_s (local.get $xlf)))
            (local.set $xri (i32.trunc_sat_f64_s (f64.ceil (local.get $xr))))
            (local.set $p (i32.add (local.get $RMIN) (i32.shl (local.get $ry) (i32.const 2))))
            (if (i32.lt_s (local.get $xli) (i32.load (local.get $p)))
              (then (i32.store (local.get $p) (local.get $xli))))
            (local.set $p (i32.add (local.get $RMAX) (i32.shl (local.get $ry) (i32.const 2))))
            (if (i32.gt_s (i32.add (local.get $xri) (i32.const 1)) (i32.load (local.get $p)))
              (then (i32.store (local.get $p) (i32.add (local.get $xri) (i32.const 1)))))
            ;; p: the cell at (row, xli)
            (local.set $p (i32.add (local.get $A)
              (i32.shl (i32.add (local.get $ls) (local.get $xli)) (i32.const 2))))
            (if (i32.le_s (local.get $xri) (i32.add (local.get $xli) (i32.const 1)))
              (then
                (local.set $xmf (f64.sub (f64.mul (f64.const 0.5) (f64.add (local.get $x) (local.get $xn)))
                  (local.get $xlf)))
                (call $add (local.get $p) (f64.sub (local.get $d) (f64.mul (local.get $d) (local.get $xmf))))
                (call $add (i32.add (local.get $p) (i32.const 4)) (f64.mul (local.get $d) (local.get $xmf))))
              (else
                (local.set $sl (f64.div (f64.const 1) (f64.sub (local.get $xr) (local.get $xl))))
                (local.set $x0f (f64.sub (local.get $xl) (local.get $xlf)))
                (local.set $a0 (f64.mul (f64.mul (f64.mul (f64.const 0.5) (local.get $sl))
                  (f64.sub (f64.const 1) (local.get $x0f))) (f64.sub (f64.const 1) (local.get $x0f))))
                (local.set $x1f (f64.add (f64.sub (local.get $xr) (f64.convert_i32_s (local.get $xri)))
                  (f64.const 1)))
                (local.set $am (f64.mul (f64.mul (f64.mul (f64.const 0.5) (local.get $sl)) (local.get $x1f))
                  (local.get $x1f)))
                (call $add (local.get $p) (f64.mul (local.get $d) (local.get $a0)))
                (if (i32.eq (local.get $xri) (i32.add (local.get $xli) (i32.const 2)))
                  (then
                    (call $add (i32.add (local.get $p) (i32.const 4))
                      (f64.mul (local.get $d)
                        (f64.sub (f64.sub (f64.const 1) (local.get $a0)) (local.get $am)))))
                  (else
                    (local.set $a1 (f64.mul (local.get $sl) (f64.sub (f64.const 1.5) (local.get $x0f))))
                    (call $add (i32.add (local.get $p) (i32.const 4))
                      (f64.mul (local.get $d) (f64.sub (local.get $a1) (local.get $a0))))
                    (local.set $xi (i32.add (local.get $xli) (i32.const 2)))
                    (block $mid (loop $m
                      (br_if $mid (i32.ge_s (local.get $xi) (i32.sub (local.get $xri) (i32.const 1))))
                      (call $add (i32.add (local.get $A)
                          (i32.shl (i32.add (local.get $ls) (local.get $xi)) (i32.const 2)))
                        (f64.mul (local.get $d) (local.get $sl)))
                      (local.set $xi (i32.add (local.get $xi) (i32.const 1)))
                      (br $m)))
                    (local.set $a2 (f64.add (local.get $a1)
                      (f64.mul (f64.convert_i32_s (i32.sub (i32.sub (local.get $xri) (local.get $xli)) (i32.const 3)))
                        (local.get $sl))))
                    (call $add (i32.add (local.get $A)
                        (i32.shl (i32.add (local.get $ls) (i32.sub (local.get $xri) (i32.const 1))) (i32.const 2)))
                      (f64.mul (local.get $d)
                        (f64.sub (f64.sub (f64.const 1) (local.get $a2)) (local.get $am))))))
                (call $add (i32.add (local.get $A)
                    (i32.shl (i32.add (local.get $ls) (local.get $xri)) (i32.const 2)))
                  (f64.mul (local.get $d) (local.get $am))))))
          (local.set $y (f64.add (local.get $y) (f64.const 1)))
          (br $row))))
      (local.set $o (i32.add (local.get $o) (i32.const 40)))
      (br $seg))))

  ;; one row's cells A[r0, r1) → coverage COV[ox + i] and spans (x0, x1 pairs of i32) at SP; returns the span count
  (func $row (export "row")
    (param $A i32) (param $r0 i32) (param $r1 i32) (param $eo i32) (param $COV i32) (param $ox i32) (param $SP i32)
    (result i32)
    (local $i i32) (local $j i32) (local $run f64) (local $ai f64) (local $c f64) (local $s0 i32) (local $hi i32)
    (local $n i32) (local $p i32) (local $q i32) (local $ones v128)
    (local.set $s0 (i32.const -1))
    (local.set $hi (i32.const -1))
    (local.set $ones (f32x4.splat (f32.const 1)))
    (local.set $i (local.get $r0))
    (block $done (loop $cell
      (br_if $done (i32.ge_s (local.get $i) (local.get $r1)))
      (block $next
        (local.set $ai (f64.promote_f32 (f32.load (i32.add (local.get $A) (i32.shl (local.get $i) (i32.const 2))))))
        (br_if $next (i32.and (i32.and (f64.eq (local.get $ai) (f64.const 0))
          (i32.lt_s (local.get $s0) (i32.const 0))) (f64.eq (local.get $run) (f64.const 0))))
        (local.set $run (f64.add (local.get $run) (local.get $ai)))
        (local.set $c (select (f64.neg (local.get $run)) (local.get $run) (f64.lt (local.get $run) (f64.const 0))))
        (if (local.get $eo)
          (then
            (local.set $c (f64.sub (local.get $c)
              (f64.mul (f64.const 2) (f64.floor (f64.div (local.get $c) (f64.const 2))))))
            (if (f64.gt (local.get $c) (f64.const 1))
              (then (local.set $c (f64.sub (f64.const 2) (local.get $c))))))
          (else (if (f64.gt (local.get $c) (f64.const 1)) (then (local.set $c (f64.const 1))))))
        (if (f64.lt (local.get $c) (f64.const 1e-6))
          (then
            (if (i32.ge_s (local.get $s0) (i32.const 0))
              (then
                (local.set $p (i32.add (local.get $SP) (i32.shl (local.get $n) (i32.const 3))))
                (i32.store (local.get $p) (i32.add (local.get $ox) (local.get $s0)))
                (i32.store offset=4 (local.get $p) (i32.add (local.get $ox) (local.get $i)))
                (local.set $n (i32.add (local.get $n) (i32.const 1)))
                (local.set $s0 (i32.const -1))))
            (br $next)))
        (if (i32.lt_s (local.get $s0) (i32.const 0)) (then (local.set $s0 (local.get $i))))
        (if (i32.and (i32.and (f64.eq (local.get $c) (f64.const 1)) (i32.eqz (local.get $eo)))
              (f32.eq (f32.load offset=4 (i32.add (local.get $A) (i32.shl (local.get $i) (i32.const 2))))
                (f32.const 0)))
          (then
            ;; inside: the cells up to the next edge add nothing; all covered (four at a time)
            (local.set $j (i32.add (local.get $i) (i32.const 1)))
            (block $e (loop $z
              (br_if $e (i32.ge_s (local.get $j) (local.get $r1)))
              (br_if $e (f32.ne (f32.load (i32.add (local.get $A) (i32.shl (local.get $j) (i32.const 2))))
                (f32.const 0)))
              (local.set $j (i32.add (local.get $j) (i32.const 1)))
              (br $z)))
            (local.set $p (i32.add (local.get $COV) (i32.shl (i32.add (local.get $ox) (local.get $i)) (i32.const 2))))
            (local.set $q (i32.add (local.get $COV) (i32.shl (i32.add (local.get $ox) (local.get $j)) (i32.const 2))))
            (block $f4 (loop $v
              (br_if $f4 (i32.gt_s (i32.add (local.get $p) (i32.const 16)) (local.get $q)))
              (v128.store (local.get $p) (local.get $ones))
              (local.set $p (i32.add (local.get $p) (i32.const 16)))
              (br $v)))
            (block $f1 (loop $s
              (br_if $f1 (i32.ge_u (local.get $p) (local.get $q)))
              (f32.store (local.get $p) (f32.const 1))
              (local.set $p (i32.add (local.get $p) (i32.const 4)))
              (br $s)))
            (local.set $hi (i32.sub (local.get $j) (i32.const 1)))
            (local.set $i (i32.sub (local.get $j) (i32.const 1)))
            (br $next)))
        (local.set $hi (local.get $i))
        (f32.store (i32.add (local.get $COV) (i32.shl (i32.add (local.get $ox) (local.get $i)) (i32.const 2)))
          (f32.demote_f64 (local.get $c))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cell)))
    (if (i32.ge_s (local.get $s0) (i32.const 0))
      (then
        (local.set $p (i32.add (local.get $SP) (i32.shl (local.get $n) (i32.const 3))))
        (i32.store (local.get $p) (i32.add (local.get $ox) (local.get $s0)))
        (i32.store offset=4 (local.get $p) (i32.add (i32.add (local.get $ox) (local.get $hi)) (i32.const 1)))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))))
    (local.get $n))

  ;; the last pixel mixed (its value and alpha in 1/256ths) and what it became: flat backdrops repeat it
  (global $lastIn (mut i32) (i32.const 0))
  (global $lastOut (mut i32) (i32.const 0))
  (global $lastK (mut i32) (i32.const -1))
  (func (export "reset") (global.set $lastIn (i32.const 0)) (global.set $lastOut (i32.const 0))
    (global.set $lastK (i32.const -1)))

  ;; d + ((s - d) k + 128 >> 8) for one byte, as the JS does it (the product in double, truncated to int32)
  (func $mix (param $p i32) (param $s f64) (param $k i32)
    (local $d i32) (local $v i32)
    (local.set $d (i32.load8_u (local.get $p)))
    (local.set $v (i32.add (local.get $d) (i32.shr_s
      (i32.trunc_sat_f64_s (f64.add (f64.mul (f64.sub (local.get $s) (f64.convert_i32_s (local.get $d)))
        (f64.convert_i32_s (local.get $k))) (f64.const 128))) (i32.const 8))))
    (i32.store8 (local.get $p) (select (i32.const 0)
      (select (i32.const 255) (local.get $v) (i32.gt_s (local.get $v) (i32.const 255)))
      (i32.lt_s (local.get $v) (i32.const 0)))))

  ;; one colour through coverage onto pixels [xa, xb) of row y (no clip): whole pixels a run of native stores
  (func $solid (export "solid")
    (param $D i32) (param $W i32) (param $y i32) (param $xa i32) (param $xb i32) (param $COV i32) (param $alpha f64)
    (param $r f64) (param $g f64) (param $b f64) (param $solid i32) (param $opaque i32) (param $CLIP i32)
    (local $cl i32) (local $x i32) (local $e i32) (local $o i32) (local $a f64) (local $k i32) (local $v i32) (local $da i32)
    (local $q i32) (local $sv v128) (local $row i32)
    (local.set $sv (i32x4.splat (local.get $solid)))
    (local.set $row (i32.add (local.get $D) (i32.shl (i32.mul (local.get $y) (local.get $W)) (i32.const 2))))
    ;; the clip mask's row (0: no clip)
    (if (local.get $CLIP)
      (then (local.set $CLIP (i32.add (local.get $CLIP) (i32.mul (local.get $y) (local.get $W))))))
    (local.set $x (local.get $xa))
    (block $done (loop $px
      (br_if $done (i32.ge_s (local.get $x) (local.get $xb)))
      (block $next
        (local.set $o (i32.add (local.get $row) (i32.shl (local.get $x) (i32.const 2))))
        (local.set $a (f64.promote_f32 (f32.load (i32.add (local.get $COV) (i32.shl (local.get $x) (i32.const 2))))))
        (if (local.get $CLIP)
          (then (local.set $cl (i32.load8_u (i32.add (local.get $CLIP) (local.get $x))))))
        (if (i32.and (i32.and (local.get $opaque) (f64.ge (local.get $a) (f64.const 1)))
              (i32.or (i32.eqz (local.get $CLIP)) (i32.eq (local.get $cl) (i32.const 255))))
          (then
            (local.set $e (i32.add (local.get $x) (i32.const 1)))
            (block $re (loop $rl
              (br_if $re (i32.ge_s (local.get $e) (local.get $xb)))
              (br_if $re (i32.eqz (f32.ge (f32.load (i32.add (local.get $COV) (i32.shl (local.get $e) (i32.const 2))))
                (f32.const 1))))
              (if (local.get $CLIP)
                (then (br_if $re (i32.ne (i32.load8_u (i32.add (local.get $CLIP) (local.get $e))) (i32.const 255)))))
              (local.set $e (i32.add (local.get $e) (i32.const 1)))
              (br $rl)))
            (local.set $q (i32.add (local.get $row) (i32.shl (local.get $e) (i32.const 2))))
            (block $f4 (loop $v4
              (br_if $f4 (i32.gt_u (i32.add (local.get $o) (i32.const 16)) (local.get $q)))
              (v128.store (local.get $o) (local.get $sv))
              (local.set $o (i32.add (local.get $o) (i32.const 16)))
              (br $v4)))
            (block $f1 (loop $v1
              (br_if $f1 (i32.ge_u (local.get $o) (local.get $q)))
              (i32.store (local.get $o) (local.get $solid))
              (local.set $o (i32.add (local.get $o) (i32.const 4)))
              (br $v1)))
            (local.set $x (i32.sub (local.get $e) (i32.const 1)))
            (br $next)))
        (local.set $a (f64.mul (local.get $a) (local.get $alpha)))
        (if (local.get $CLIP)
          (then (local.set $a (f64.mul (local.get $a)
            (f64.div (f64.convert_i32_u (local.get $cl)) (f64.const 255))))))
        (br_if $next (f64.le (local.get $a) (f64.const 0)))
        (if (f64.ge (local.get $a) (f64.const 1))
          (then (i32.store (local.get $o) (local.get $solid)) (br $next)))
        (local.set $k (i32.trunc_sat_f64_s (f64.add (f64.mul (local.get $a) (f64.const 256)) (f64.const 0.5))))
        (local.set $v (i32.load (local.get $o)))
        (if (i32.and (i32.eq (local.get $v) (global.get $lastIn)) (i32.eq (local.get $k) (global.get $lastK)))
          (then (i32.store (local.get $o) (global.get $lastOut)) (br $next)))
        (local.set $da (i32.load8_u offset=3 (local.get $o)))
        (i32.store8 offset=3 (local.get $o) (i32.add (local.get $da) (i32.shr_s
          (i32.add (i32.mul (i32.sub (i32.const 255) (local.get $da)) (local.get $k)) (i32.const 128)) (i32.const 8))))
        (call $mix (local.get $o) (local.get $r) (local.get $k))
        (call $mix (i32.add (local.get $o) (i32.const 1)) (local.get $g) (local.get $k))
        (call $mix (i32.add (local.get $o) (i32.const 2)) (local.get $b) (local.get $k))
        (global.set $lastIn (local.get $v))
        (global.set $lastOut (i32.load (local.get $o)))
        (global.set $lastK (local.get $k)))
      (local.set $x (i32.add (local.get $x) (i32.const 1)))
      (br $px))))
;; a row swept and its spans composited in one colour (row, then solid per span): no call out per span
  (func (export "rowsolid")
    (param $A i32) (param $r0 i32) (param $r1 i32) (param $COV i32) (param $ox i32) (param $SP i32)
    (param $D i32) (param $W i32) (param $y i32) (param $alpha f64) (param $r f64) (param $g f64) (param $b f64)
    (param $solidpx i32) (param $opaque i32) (param $CLIP i32)
    (local $n i32) (local $i i32) (local $p i32)
    (local.set $n (call $row (local.get $A) (local.get $r0) (local.get $r1) (i32.const 0) (local.get $COV)
      (local.get $ox) (local.get $SP)))
    (block $done (loop $s
      (br_if $done (i32.ge_s (local.get $i) (local.get $n)))
      (local.set $p (i32.add (local.get $SP) (i32.shl (local.get $i) (i32.const 3))))
      (call $solid (local.get $D) (local.get $W) (local.get $y) (i32.load (local.get $p))
        (i32.load offset=4 (local.get $p)) (local.get $COV) (local.get $alpha) (local.get $r) (local.get $g)
        (local.get $b) (local.get $solidpx) (local.get $opaque) (local.get $CLIP))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $s))))
;; a radial shading's table entry per pixel along a row (shading.js span, type 3): the point steps by (sx, sy)
  (func (export "radial")
    (param $I i32) (param $m i32) (param $px f64) (param $py f64) (param $b f64) (param $sx f64) (param $sy f64)
    (param $db f64) (param $a f64) (param $ia f64) (param $r00 f64) (param $r0 f64) (param $dr f64) (param $e0 i32)
    (param $e1 i32) (param $n f64) (param $out i32)
    (local $i i32) (local $disc f64) (local $q f64) (local $s1 f64) (local $s2 f64) (local $hi f64) (local $lo f64)
    (local $t f64) (local $v i32)
    (block $done (loop $px1
      (br_if $done (i32.ge_s (local.get $i) (local.get $m)))
      (local.set $t (f64.const nan))
      (local.set $disc (f64.sub (f64.mul (local.get $b) (local.get $b))
        (f64.mul (local.get $a) (f64.sub (f64.add (f64.mul (local.get $px) (local.get $px))
          (f64.mul (local.get $py) (local.get $py))) (local.get $r00)))))
      (if (f64.ge (local.get $disc) (f64.const 0))
        (then
          (local.set $q (f64.sqrt (local.get $disc)))
          (local.set $s1 (f64.mul (f64.add (local.get $b) (local.get $q)) (local.get $ia)))
          (local.set $s2 (f64.mul (f64.sub (local.get $b) (local.get $q)) (local.get $ia)))
          (local.set $hi (select (local.get $s1) (local.get $s2) (f64.gt (local.get $s1) (local.get $s2))))
          (local.set $lo (select (local.get $s2) (local.get $s1) (f64.gt (local.get $s1) (local.get $s2))))
          (if (i32.and (f64.ge (f64.add (local.get $r0) (f64.mul (local.get $hi) (local.get $dr))) (f64.const 0))
                (i32.and (i32.or (f64.ge (local.get $hi) (f64.const 0)) (local.get $e0))
                  (i32.or (f64.le (local.get $hi) (f64.const 1)) (local.get $e1))))
            (then (local.set $t (local.get $hi)))
            (else
              (if (i32.and (f64.ge (f64.add (local.get $r0) (f64.mul (local.get $lo) (local.get $dr))) (f64.const 0))
                    (i32.and (i32.or (f64.ge (local.get $lo) (f64.const 0)) (local.get $e0))
                      (i32.or (f64.le (local.get $lo) (f64.const 1)) (local.get $e1))))
                (then (local.set $t (local.get $lo))))))))
      (local.set $v
        (if (result i32) (f64.ne (local.get $t) (local.get $t))
          (then (local.get $out))
          (else (if (result i32) (f64.lt (local.get $t) (f64.const 0))
            (then (i32.const 0))
            (else (if (result i32) (f64.gt (local.get $t) (f64.const 1))
              (then (i32.trunc_sat_f64_s (local.get $n)))
              (else (i32.trunc_sat_f64_s (f64.add (f64.mul (local.get $t) (local.get $n)) (f64.const 0.5))))))))))
      (i32.store (i32.add (local.get $I) (i32.shl (local.get $i) (i32.const 2))) (local.get $v))
      (local.set $px (f64.add (local.get $px) (local.get $sx)))
      (local.set $py (f64.add (local.get $py) (local.get $sy)))
      (local.set $b (f64.add (local.get $b) (local.get $db)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $px1))))
;; a double stored into a byte as a Uint8ClampedArray stores it: NaN and below 0 → 0, above 255 → 255, else
  ;; rounded to nearest, ties to even
  (func $u8c (param $p i32) (param $v f64)
    (i32.store8 (local.get $p)
      (if (result i32) (f64.gt (local.get $v) (f64.const 0))
        (then (if (result i32) (f64.ge (local.get $v) (f64.const 255))
          (then (i32.const 255))
          (else (i32.trunc_sat_f64_s (f64.nearest (local.get $v))))))
        (else (i32.const 0)))))

  ;; a layer row over a page row (render.js composite, Normal): L, D pixel rows at x0..x1, M the mask row or 0.
  ;; plain: full alpha, no mask, in the integer-like form; else through the mask (or alpha ga alone)
  (func (export "layer")
    (param $L i32) (param $D i32) (param $M i32) (param $x0 i32) (param $x1 i32) (param $ga f64) (param $plain i32)
    (local $i i32) (local $p i32) (local $q i32) (local $la i32) (local $k f64) (local $s f64) (local $a f64)
    (local.set $i (local.get $x0))
    (block $done (loop $px
      (br_if $done (i32.ge_s (local.get $i) (local.get $x1)))
      (block $next
        (local.set $p (i32.add (local.get $L) (i32.shl (local.get $i) (i32.const 2))))
        (local.set $q (i32.add (local.get $D) (i32.shl (local.get $i) (i32.const 2))))
        (br_if $next (i32.eqz (i32.load (local.get $p))))
        (local.set $la (i32.load8_u offset=3 (local.get $p)))
        (if (local.get $plain)
          (then
            (if (i32.eq (local.get $la) (i32.const 255))
              (then (i32.store (local.get $q) (i32.load (local.get $p))) (br $next)))
            (local.set $k (f64.convert_i32_s (i32.sub (i32.const 255) (local.get $la))))
            (call $u8c (local.get $q) (f64.add (f64.convert_i32_u (i32.load8_u (local.get $p)))
              (f64.div (f64.add (f64.mul (f64.convert_i32_u (i32.load8_u (local.get $q))) (local.get $k)) (f64.const 127)) (f64.const 255))))
            (call $u8c (i32.add (local.get $q) (i32.const 1)) (f64.add (f64.convert_i32_u (i32.load8_u offset=1 (local.get $p)))
              (f64.div (f64.add (f64.mul (f64.convert_i32_u (i32.load8_u offset=1 (local.get $q))) (local.get $k)) (f64.const 127)) (f64.const 255))))
            (call $u8c (i32.add (local.get $q) (i32.const 2)) (f64.add (f64.convert_i32_u (i32.load8_u offset=2 (local.get $p)))
              (f64.div (f64.add (f64.mul (f64.convert_i32_u (i32.load8_u offset=2 (local.get $q))) (local.get $k)) (f64.const 127)) (f64.const 255))))
            (call $u8c (i32.add (local.get $q) (i32.const 3)) (f64.add (f64.convert_i32_u (local.get $la))
              (f64.div (f64.add (f64.mul (f64.convert_i32_u (i32.load8_u offset=3 (local.get $q))) (local.get $k)) (f64.const 127)) (f64.const 255))))
            (br $next)))
        (local.set $s (if (result f64) (local.get $M)
          (then (f64.div (f64.mul (local.get $ga) (f64.convert_i32_u (i32.load8_u (i32.add (local.get $M) (local.get $i)))))
            (f64.const 255)))
          (else (local.get $ga))))
        (br_if $next (i32.eqz (local.get $la)))
        (br_if $next (f64.le (local.get $s) (f64.const 0)))
        (local.set $a (f64.mul (f64.div (f64.convert_i32_u (local.get $la)) (f64.const 255)) (local.get $s)))
        (local.set $k (f64.sub (f64.const 1) (local.get $a)))
        (call $u8c (local.get $q) (f64.add (f64.mul (f64.convert_i32_u (i32.load8_u (local.get $q))) (local.get $k))
          (f64.mul (f64.convert_i32_u (i32.load8_u (local.get $p))) (local.get $s))))
        (call $u8c (i32.add (local.get $q) (i32.const 1)) (f64.add (f64.mul (f64.convert_i32_u (i32.load8_u offset=1 (local.get $q))) (local.get $k))
          (f64.mul (f64.convert_i32_u (i32.load8_u offset=1 (local.get $p))) (local.get $s))))
        (call $u8c (i32.add (local.get $q) (i32.const 2)) (f64.add (f64.mul (f64.convert_i32_u (i32.load8_u offset=2 (local.get $q))) (local.get $k))
          (f64.mul (f64.convert_i32_u (i32.load8_u offset=2 (local.get $p))) (local.get $s))))
        (call $u8c (i32.add (local.get $q) (i32.const 3)) (f64.add (f64.mul (f64.convert_i32_u (i32.load8_u offset=3 (local.get $q))) (local.get $k))
          (f64.mul (f64.convert_i32_u (local.get $la)) (local.get $s)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $px))))
)
