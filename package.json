{
  "name": "@reportwright/pdf",
  "version": "0.1.0-beta.6",
  "description": "A streaming PDF writer for Node and browsers with no runtime dependencies: flat memory, PDF/A-1b to 3a, PDF/UA-1, Factur-X, embedded TrueType with Unicode text.",
  "type": "module",
  "license": "MIT",
  "author": "Arun Mallikarjun",
  "homepage": "https://github.com/MrArun005/reportwright/tree/main/packages/pdf#readme",
  "bugs": { "url": "https://github.com/MrArun005/reportwright/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/MrArun005/reportwright.git", "directory": "packages/pdf" },
  "keywords": ["pdf", "pdf-writer", "streaming", "pdf-a", "pdf-ua", "factur-x", "zugferd", "accessibility", "truetype", "encryption", "aes", "pades", "digital-signature", "reportwright"],
  "publishConfig": { "access": "public" },
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./dist/index.js" },
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": ["dist", "index.d.ts", "examples", "README.md", "LICENSE", "THIRD-PARTY-NOTICES.md"],
  "engines": { "node": ">=20.16" },
  "sideEffects": false
}
