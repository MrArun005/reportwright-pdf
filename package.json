{
  "name": "@reportwright/pdf",
  "version": "0.1.0-beta.12",
  "description": "A streaming PDF writer for Node and browsers with no runtime dependencies: flat memory, PDF/A-1b to 3a, PDF/UA-1, Factur-X, embedded TrueType with Unicode text.",
  "type": "module",
  "license": "MIT",
  "author": "Arun Mallikarjun",
  "homepage": "https://github.com/MrArun005/reportwright/tree/main/packages/pdf#readme",
  "bugs": {
    "url": "https://github.com/MrArun005/reportwright/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrArun005/reportwright.git",
    "directory": "packages/pdf"
  },
  "keywords": [
    "pdf",
    "pdf-writer",
    "streaming",
    "pdf-a",
    "pdf-ua",
    "factur-x",
    "zugferd",
    "accessibility",
    "truetype",
    "encryption",
    "aes",
    "pades",
    "digital-signature",
    "reportwright"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    },
    "./write": {
      "types": "./write.d.ts",
      "default": "./dist/write.js"
    },
    "./fflate": {
      "types": "./fflate.d.ts",
      "default": "./dist/fflate.js"
    },
    "./examples/*": "./examples/*",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "write.d.ts",
    "fflate.d.ts",
    "examples",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{js,mjs}\" \"tests/**/*.{js,mjs}\" \"tools/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs}\" \"tests/**/*.{js,mjs}\" \"tools/**/*.{js,mjs}\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.2",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "prettier": "3.9.9",
    "sharp": "^0.34.3",
    "vitest": "^5.0.3"
  }
}
